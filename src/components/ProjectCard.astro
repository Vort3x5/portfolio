---
import { marked } from 'marked';

interface Props {
  name: string;
  repo: string;
  tags: string[];
  featured?: boolean;
}

const { name, repo, tags, featured } = Astro.props;

// Fetch README from GitHub
let readme = '';
let error = false;

try {
  const response = await fetch(
    `https://api.github.com/repos/${repo}/readme`,
    {
      headers: {
        'Accept': 'application/vnd.github.v3.raw',
        'User-Agent': 'Astro Portfolio',
      }
    }
  );
  
  if (response.ok) {
    const readmeRaw = await response.text();
    // Convert markdown to HTML
    readme = await marked(readmeRaw);
  } else {
    error = true;
  }
} catch (e) {
  error = true;
}

const repoUrl = `https://github.com/${repo}`;
---

<article class="project-card" class:list={{ featured }}>
  <div class="card-header">
    <h3>
      <a href={repoUrl} target="_blank" rel="noopener noreferrer">
        {name}
      </a>
    </h3>
    {featured && (
      <span class="featured-badge">
        ⭐ Featured
      </span>
    )}
  </div>

  <div class="tags">
    {tags.map(tag => <span class="tag">{tag}</span>)}
  </div>

  <div class="readme-content">
    {error ? (
      <p class="error">Failed to load README</p>
    ) : (
      <div class="markdown" set:html={readme} />
    )}
  </div>

  <div class="card-footer">
    <a href={repoUrl} class="view-repo" target="_blank" rel="noopener noreferrer">
      View Repository →
    </a>
  </div>
</article>

<style>
  .project-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    transition: all 0.3s;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-card:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .project-card.featured {
    border-color: var(--warning);
    background: linear-gradient(135deg, var(--bg-secondary) 0%, rgba(210, 153, 34, 0.05) 100%);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
    gap: 1rem;
  }

  h3 {
    font-size: 1.5rem;
    margin: 0;
  }

  h3 a {
    color: var(--text-primary);
  }

  h3 a:hover {
    color: var(--accent);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-bottom: 1rem;
  }

  .readme-content {
    flex: 1;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .markdown {
    max-height: 400px;
    overflow-y: auto;
    padding-right: 0.5rem;
  }

  .markdown :global(h1) {
    font-size: 1.5rem;
    margin: 1rem 0 0.5rem;
    color: var(--text-primary);
  }

  .markdown :global(h2) {
    font-size: 1.3rem;
    margin: 1rem 0 0.5rem;
    color: var(--text-primary);
  }

  .markdown :global(h3) {
    font-size: 1.1rem;
    margin: 0.75rem 0 0.5rem;
    color: var(--text-primary);
  }

  .markdown :global(p) {
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }

  .markdown :global(ul),
  .markdown :global(ol) {
    margin-left: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--text-secondary);
  }

  .markdown :global(li) {
    margin-bottom: 0.25rem;
  }

  .markdown :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1rem 0;
  }

  .markdown :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    margin: 1rem 0;
    color: var(--text-secondary);
    font-style: italic;
  }

  .error {
    color: var(--warning);
    font-style: italic;
  }

  .card-footer {
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }

  .view-repo {
    display: inline-flex;
    align-items: center;
    font-weight: 500;
  }
</style>
